# ---------------------------------------------------------------------------
# .env.example — Variables para docker compose (root compose.yml)
# ---------------------------------------------------------------------------
# Copia este archivo a .env y completa los valores reales.
# .env está en .gitignore y nunca debe commitearse.
#
# Modo standalone por servicio: cada servicio tiene su propio mecanismo
#   api/     → ./mvnw spring-boot:run -Dspring.profiles.active=local
#              (levanta api/compose.yml automáticamente para la DB)
#   web/     → npm run dev (lee web/.env.local)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Firebase Admin SDK — credenciales del servidor (SECRETO, nunca al browser)
# ---------------------------------------------------------------------------
# Ruta absoluta al archivo JSON de la service account de Firebase Admin.
# Se monta en el contenedor del API como /run/secrets/firebase-admin-key.json
FIREBASE_ADMIN_KEY_PATH=/home/you/.config/gradeops/firebase-service-account.json

# ---------------------------------------------------------------------------
# API — secreto interno para endpoints protegidos entre servicios
# ---------------------------------------------------------------------------
INTERNAL_API_SECRET=dev-secret-change-me

# ---------------------------------------------------------------------------
# Agents — Groq (obligatorio) y Gemini (opcional, no usado en local)
# ---------------------------------------------------------------------------
# https://console.groq.com/keys
GRADEOPS_GROQ_API_KEY=your-groq-api-key
GRADEOPS_GROQ_MODEL=llama-3.3-70b-versatile
# Opcional: solo si quieres probar el modelo Gemini en local en vez de Groq.
GRADEOPS_GEMINI_API_KEY=not-used-locally
GRADEOPS_GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Firebase web configuration — baked in durante el build de Next.js
# ---------------------------------------------------------------------------
# Valores disponibles en: Firebase Console → Project Settings → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ---------------------------------------------------------------------------
# Render beta smoke (scripts/smoke-e2e-render-beta.sh) — opcional, solo
# necesario para correr el smoke script contra el ambiente beta desplegado
# en Render. INTERNAL_API_SECRET y NEXT_PUBLIC_FIREBASE_API_KEY (arriba)
# también son requeridos por ese script y se reutilizan tal cual.
# ---------------------------------------------------------------------------
# Render Dashboard → Account Settings → API Keys
RENDER_API_KEY=your-render-api-key
# Id del workspace/team que es dueño de grade-ops-ai-api/grade-ops-ai-agents.
# Ver .planning/active/008-assessment-creation/02-deepening/story-04-e2e-integration-verification/evidence/task-03-verify-render-beta-live.md
# para cómo resolverlo vía GET https://api.render.com/v1/owners si no lo conoces.
RENDER_WORKSPACE_ID=tea-xxxxxxxxxxxxxxxxxxxx
# URL pública del servicio api/ desplegado en Render (el hostname *.onrender.com
# es un slug propio que NO cambia si renombras el service en el dashboard).
BETA_API_BASE_URL=https://your-api-service.onrender.com
# Opcional: solo si los nombres de servicio en Render difieren de los defaults.
# RENDER_API_SERVICE_NAME=grade-ops-ai-api
# RENDER_AGENTS_SERVICE_NAME=grade-ops-ai-agents
